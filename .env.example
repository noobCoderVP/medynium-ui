# Copy to .env.local for local development. Never commit .env.local.

# FastAPI backend. Server-side only: next.config.ts proxies /api/* to it, so the browser never sees it
# and the session cookie stays same-origin. Locally: http://localhost:8000.
# On Vercel: the Render URL, e.g. https://medynium-api.onrender.com  (REQUIRED-FROM-YOU after the backend is deployed)
BACKEND_URL=http://localhost:8000

# Shown in the page title and header. Safe to expose.
NEXT_PUBLIC_APP_NAME=Medynium
